build/
*.app/
*.icns
*.iconset/
build-*.log

# ---------------------------------------------------------------------------
# Test artifacts
# Tools/run_tests.sh and the uitest/snapshot binaries take their work directory
# as an argument; these anchored patterns catch the case of pointing one at the
# repo root instead of a scratch dir.
# ---------------------------------------------------------------------------
/fixtures/
/out/
/testwork/
/snapshots/

